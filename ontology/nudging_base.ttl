#################################################################
#    Individuals
#################################################################

###  https://purl.archive.org/nudging#women
ndg:women rdf:type owl:NamedIndividual ,
                   ndg:Women ;
          rdfs:label "women" .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ndg:Census
                ndg:City
                ndg:Country
                ndg:County
                ndg:District
                ndg:StatisticZone
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ndg:Company
                ndg:NonProfitOrganization
                ndg:PublicAdministration
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ndg:ForeignMen
                ndg:ForeignWomen
                ndg:Men
                ndg:Women
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( ndg:InternationalPolicy
                ndg:NationalPolicy
                ndg:RegionalPolicy
              )
] .


