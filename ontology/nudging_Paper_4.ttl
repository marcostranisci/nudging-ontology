###  http://www.semanticweb.org/monic/ontologies/2026/0/untitled-ontology-120/address_racial_bias_in_crime_reporting
:address_racial_bias_in_crime_reporting rdf:type owl:NamedIndividual ,
                                                 nudging:PoliticalAction ;
                                        nudging:bringsAbout :reduced_stereotype_based_neighborhood_evaluation ;
                                        nudging:challenges :african-americans_segregation_in_neighbourhoods ;
                                        rdfs:comment "Address racial bias in crime reporting and promote positive stories from minority communities."@en ;
                                        rdfs:label "Address racial bias in crime reporting" .


###  http://www.semanticweb.org/monic/ontologies/2026/0/untitled-ontology-120/african-americans_segregation_in_neighbourhoods
:african-americans_segregation_in_neighbourhoods rdf:type owl:NamedIndividual ,
                                                          nudging:SocialIssue ;
                                                 rdfs:comment "African-Americans remain more segregated than any other racial or ethnic group and this residential isolation persists across all levels of socio economic attainment. White avoidance of neighborhoods with blacks are key processes that maintain high levels of racial segregation: could be because of racial aversion"@en ;
                                                 rdfs:label "african american segregation in neighbourhoods" .


###  http://www.semanticweb.org/monic/ontologies/2026/0/untitled-ontology-120/anti-bias_training_for_police
:anti-bias_training_for_police rdf:type owl:NamedIndividual ,
                                        nudging:PoliticalAction ;
                               nudging:bringsAbout :reduced_stereotype_based_neighborhood_evaluation ;
                               nudging:challenges :african-americans_segregation_in_neighbourhoods ;
                               rdfs:comment "Implement anti-bias training for police and encourage community policing to build trust and reduce racialized fears of crime."@en ;
                               rdfs:label "anti-bias training for police" .


