                                                                                                                            <https://purl.archive.org/nudging#working-age_adults> ;
                                                                     <https://purl.archive.org/nudging#references> <https://purl.archive.org/nudging#Cao_and_Chatman> ,
                                                                                                                   <https://purl.archive.org/nudging#Cao_et_al> ,
                                                                                                                   <https://purl.archive.org/nudging#Cervero_and_Kockelman> ,
                                                                                                                   <https://purl.archive.org/nudging#Ewing_and_Cervero> ,
                                                                                                                   <https://purl.archive.org/nudging#Mokhtarian_and_Cao> ,
                                                                                                                   <https://purl.archive.org/nudging#Rosenbaum_and_Rubin> ,
                                                                                                                   <https://purl.archive.org/nudging#Schirmer_et_al> ;
